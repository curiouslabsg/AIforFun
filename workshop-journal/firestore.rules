rules_version = '2';

// Data layout
//   teachers/{email}                                   added by hand in the Firebase console
//   workshops/{code}                                   created by a teacher from teacher.html
//   workshops/{code}/students/{sid}                    one per student (sid = team + name slug)
//   workshops/{code}/students/{sid}/claims/{uid}       proves this device knew the student's PIN
//   workshops/{code}/students/{sid}/entries/{entryId}  journal entries
//   workshops/{code}/students/{sid}/images/{imageId}   prototype photos and sketches (JPEG data URLs)
//   workshops/{code}/students/{sid}/feedback/{noteId}  peer feedback sticky notes from the gallery walk
//   workshops/{code}/teams/{key}                       shared team journal; key is "<class>-t<team>", e.g. "1A-t1"
//     members/{uid}  entries/{stageId}  images/{id}  feedback/{id}  locks/{stage__prompt}
//   settings/school                                    activeWorkshops (where students land, up to 5) + legacy fields
//   roster/{tg}                                        teaching group: level + student names (students pick from it)
//   rosterDetails/{tg}                                 teacher-only: each student's form class and teacher
//
// Students sign in anonymously. A device owns a journal once it has written a
// claim doc whose pinHash matches the student's pinHash. Teachers sign in with
// Google and must have a doc in /teachers named after their email.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      // Anonymous student accounts have no email, so read it with a default.
      return signedIn()
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role == 'admin';
    }

    function workshopPath(code) {
      return /databases/$(database)/documents/workshops/$(code);
    }

    function workshopOpen(code) {
      return get(workshopPath(code)).data.open == true;
    }

    function studentPath(code, sid) {
      return /databases/$(database)/documents/workshops/$(code)/students/$(sid);
    }

    function ownsJournal(code, sid) {
      return signedIn()
        && exists(/databases/$(database)/documents/workshops/$(code)/students/$(sid)/claims/$(request.auth.uid));
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Admins manage the teacher list from teacher.html. The first admin is added in the console.
    // An admin can't remove or demote themselves, so there is always at least one admin.
    match /teachers/{email} {
      allow read: if isTeacher();
      allow create: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')
        && request.resource.data.keys().hasOnly(['name', 'role', 'addedBy', 'addedAt'])
        && request.resource.data.role in ['teacher', 'admin']
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 60)
        && request.resource.data.addedBy == request.auth.token.email;
      allow update: if (isAdmin()
          && email != request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name'])
          && request.resource.data.role in ['teacher', 'admin'])
        // Any teacher can set their own name, which links them to "their" students.
        || (isTeacher()
          && email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60);
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /settings/school {
      allow get: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['teachers', 'activeWorkshop', 'activeWorkshops', 'updatedAt', 'updatedBy'])
        && (!('teachers' in request.resource.data)
            || (request.resource.data.teachers is list && request.resource.data.teachers.size() <= 50))
        && (!('activeWorkshop' in request.resource.data)
            || request.resource.data.activeWorkshop.matches('^[A-Z0-9]{4,12}$'))
        // Up to 5 workshop codes students can join at the same time.
        && (!('activeWorkshops' in request.resource.data)
            || (request.resource.data.activeWorkshops is list
                && (request.resource.data.activeWorkshops.size() == 0
                    || request.resource.data.activeWorkshops.join(',').matches('^[A-Z0-9]{4,12}(,[A-Z0-9]{4,12}){0,4}$'))));
    }

    // Class list. Students see teaching groups and names only, to pick themselves when joining.
    match /roster/{tg} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && tg.matches('^[A-Za-z0-9][A-Za-z0-9 -]{0,29}$')
        && request.resource.data.keys().hasOnly(['level', 'students', 'updatedAt', 'updatedBy'])
        && request.resource.data.level in [1, 2]
        && request.resource.data.students is list
        && request.resource.data.students.size() <= 300;
      allow delete: if isAdmin();
    }

    // Form class and teacher for each student: teachers only, never sent to student devices.
    match /rosterDetails/{tg} {
      allow read: if isTeacher();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['classes', 'teachers', 'updatedAt'])
        && request.resource.data.classes is map
        && request.resource.data.teachers is map;
      allow delete: if isAdmin();
    }

    match /workshops/{code} {
      // Students check a code with a single get; only teachers can list codes.
      allow get: if signedIn();
      allow list: if isTeacher();
      // Only admins open, close, rename and delete workshops; teachers just view them.
      allow create: if isAdmin()
        && code.matches('^[A-Z0-9]{4,12}$')
        && request.resource.data.keys().hasOnly(['name', 'track', 'open', 'createdAt', 'createdBy'])
        && shortString(request.resource.data.name, 80)
        && request.resource.data.track in ['code', 'ai']
        && request.resource.data.open is bool
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'open']);
      allow delete: if isAdmin();

      match /students/{sid} {
        // resource == null lets a student check whether a name is free before joining.
        allow get: if signedIn()
          && (resource == null || ownsJournal(code, sid) || isTeacher());
        allow list: if isTeacher();
        allow create: if signedIn()
          && workshopOpen(code)
          && request.resource.data.keys().hasOnly(['name', 'team', 'level', 'class', 'teacher', 'pin', 'pinHash', 'createdAt', 'progress', 'lastActive'])
          && shortString(request.resource.data.name, 60)
          // 'class' holds the teaching group; the name must be on that group's class list.
          && exists(/databases/$(database)/documents/roster/$(request.resource.data['class']))
          && request.resource.data.name in get(/databases/$(database)/documents/roster/$(request.resource.data['class'])).data.students
          && request.resource.data.level == get(/databases/$(database)/documents/roster/$(request.resource.data['class'])).data.level
          && (!('teacher' in request.resource.data) || request.resource.data.teacher.size() <= 60)
          && request.resource.data.pin.matches('^[0-9]{4}$')
          && request.resource.data.team is int
          && request.resource.data.team >= 1 && request.resource.data.team <= 40
          && request.resource.data.pinHash is string
          && request.resource.data.pinHash.size() == 64
          && request.resource.data.progress is map;
        allow update: if (ownsJournal(code, sid)
            && workshopOpen(code)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'lastActive'])
            && request.resource.data.progress is map
            && request.resource.data.progress.size() <= 20)
          // Teachers can reset a forgotten PIN or fix a wrong class / teacher choice.
          || (isTeacher()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'pinHash', 'level', 'class', 'teacher'])
            && request.resource.data.pin.matches('^[0-9]{4}$')
            && request.resource.data.pinHash.size() == 64);
        allow delete: if isTeacher();

        match /claims/{uid} {
          // getAfter() also covers the first claim, written in the same batch as the student doc.
          allow create: if signedIn()
            && uid == request.auth.uid
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['pinHash', 'at'])
            && request.resource.data.pinHash == getAfter(studentPath(code, sid)).data.pinHash;
          allow read: if isTeacher();
          allow update: if false;
          allow delete: if isTeacher();
        }

        match /entries/{entryId} {
          allow read: if ownsJournal(code, sid) || isTeacher();
          allow create, update: if ownsJournal(code, sid)
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['kind', 'stage', 'answers', 'type', 'tag', 'text', 'createdAt', 'updatedAt'])
            && request.resource.data.kind in ['stage', 'learning']
            && (!('type' in request.resource.data) || request.resource.data.type in ['learnt', 'gathered'])
            && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
            && (!('answers' in request.resource.data)
                || (request.resource.data.answers is map && request.resource.data.answers.size() <= 20));
          allow delete: if (ownsJournal(code, sid)
            && workshopOpen(code)
            && resource.data.kind == 'learning')
            || isTeacher();
        }

        match /images/{imageId} {
          allow read: if ownsJournal(code, sid) || isTeacher();
          allow create: if ownsJournal(code, sid)
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['stage', 'source', 'caption', 'data', 'createdAt'])
            && request.resource.data.source in ['photo', 'sketch']
            && request.resource.data.data is string
            && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
            && request.resource.data.data.size() <= 900000
            && (!('caption' in request.resource.data) || request.resource.data.caption.size() <= 200);
          allow delete: if (ownsJournal(code, sid) && workshopOpen(code)) || isTeacher();
          allow update: if false;
        }

        // Visitors type on the owner's laptop, so notes are written by the owner's device.
        // Students can't delete them (so teachers see everything); teachers can.
        match /feedback/{noteId} {
          allow read: if ownsJournal(code, sid) || isTeacher();
          allow create: if ownsJournal(code, sid)
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['from', 'like', 'wish', 'whatif', 'use', 'createdAt'])
            && shortString(request.resource.data.from, 60)
            && request.resource.data.like.size() <= 300
            && request.resource.data.wish.size() <= 300
            && request.resource.data.whatif.size() <= 300
            && (request.resource.data.like.size() + request.resource.data.wish.size() + request.resource.data.whatif.size()) > 0
            && request.resource.data.use in ['yes', 'maybe', 'no', ''];
          allow delete: if isTeacher();
          allow update: if false;
        }
      }

      // Shared team journal. A device joins a team by writing a members/{uid} doc that
      // points at a journal it owns (proved by the PIN claim) whose class and team match.
      match /teams/{key} {
        function isMember() {
          return signedIn() && exists(/databases/$(database)/documents/workshops/$(code)/teams/$(key)/members/$(request.auth.uid));
        }
        function staleLock() {
          return resource.data.at < request.time - duration.value(45, 's');
        }

        // Team docs hold only progress and the project title, so any student can browse
        // them for the gallery walk. Answers stay in the members-only subcollections.
        allow get, list: if signedIn();
        allow create, update: if isMember()
          && workshopOpen(code)
          && request.resource.data.keys().hasOnly(['progress', 'title', 'updatedAt'])
          && (!('title' in request.resource.data) || request.resource.data.title.size() <= 120)
          && request.resource.data.progress is map
          && request.resource.data.progress.size() <= 20;
        allow delete: if isTeacher();

        match /members/{uid} {
          allow get: if (signedIn() && uid == request.auth.uid) || isTeacher();
          allow list: if isMember() || isTeacher();
          allow create: if signedIn()
            && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['sid', 'name', 'at'])
            && request.resource.data.sid is string
            && ownsJournal(code, request.resource.data.sid)
            && get(studentPath(code, request.resource.data.sid)).data['class'] + '-t'
                 + string(get(studentPath(code, request.resource.data.sid)).data.team) == key
            && request.resource.data.name == get(studentPath(code, request.resource.data.sid)).data.name;
          allow update: if false;
          allow delete: if isTeacher();
        }

        match /entries/{stageId} {
          allow read: if isMember() || isTeacher();
          allow create, update: if isMember()
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['kind', 'stage', 'answers', 'createdAt', 'updatedAt'])
            && request.resource.data.kind == 'stage'
            && request.resource.data.answers is map
            && request.resource.data.answers.size() <= 20;
          allow delete: if isTeacher();
        }

        match /images/{imageId} {
          allow read: if isMember() || isTeacher();
          allow create: if isMember()
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['stage', 'source', 'caption', 'data', 'by', 'createdAt'])
            && request.resource.data.source in ['photo', 'sketch']
            && request.resource.data.data is string
            && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
            && request.resource.data.data.size() <= 900000
            && (!('caption' in request.resource.data) || request.resource.data.caption.size() <= 200)
            && (!('by' in request.resource.data) || request.resource.data.by.size() <= 40);
          allow delete: if (isMember() && workshopOpen(code)) || isTeacher();
          allow update: if false;
        }

        // Notes come from Visitor mode on a member's laptop, or from a visitor's own journal
        // on the gallery walk. A visitor's note is stored under their own student id, so each
        // visitor leaves at most one note per team and can't post as someone else.
        function visitorNote(noteId) {
          return request.resource.data.fromSid == noteId
            && exists(/databases/$(database)/documents/workshops/$(code)/students/$(noteId)/claims/$(request.auth.uid))
            && request.resource.data.from == get(/databases/$(database)/documents/workshops/$(code)/students/$(noteId)).data.name;
        }
        match /feedback/{noteId} {
          allow read: if isMember() || isTeacher();
          allow create: if signedIn()
            && (isMember() || visitorNote(noteId))
            && workshopOpen(code)
            && request.resource.data.keys().hasOnly(['from', 'fromSid', 'fromTg', 'like', 'wish', 'whatif', 'use', 'createdAt'])
            && (!('fromTg' in request.resource.data) || request.resource.data.fromTg.size() <= 30)
            && shortString(request.resource.data.from, 60)
            && request.resource.data.like.size() <= 300
            && request.resource.data.wish.size() <= 300
            && request.resource.data.whatif.size() <= 300
            && (request.resource.data.like.size() + request.resource.data.wish.size() + request.resource.data.whatif.size()) > 0
            && request.resource.data.use in ['yes', 'maybe', 'no', ''];
          allow delete: if isTeacher();
          allow update: if false;
        }

        // One teammate at a time per answer box. A lock is taken by writing the server time;
        // it can be taken over once it hasn't been refreshed for 45 seconds.
        match /locks/{field} {
          allow read: if isMember() || isTeacher();
          allow create: if isMember()
            && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.at == request.time;
          allow update: if isMember()
            && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.at == request.time
            && (resource.data.uid == request.auth.uid || staleLock());
          allow delete: if (isMember() && (resource.data.uid == request.auth.uid || staleLock())) || isTeacher();
        }
      }
    }
  }
}
